// QR Code Model 2 encoding of text as one byte-mode segment, for versions 1
// to 40, the four error correction levels and an automatically chosen mask.
// A port of Project Nayuki's QR Code generator library (MIT License, see
// LICENSE). It allocates nothing: a QrCode holds its modules and the working
// space the encoder needs.

QrEcc :: enum {
    QrEccLow :: 0
    QrEccMedium :: 1
    QrEccQuartile :: 2
    QrEccHigh :: 3
}
using QrEcc;

QR_VERSION_MIN :: 1
QR_VERSION_MAX :: 40
QR_SIZE_MAX :: 177
QR_CODEWORDS_MAX :: 3706
QR_BLOCK_MAX :: 256
QR_ECC_MAX :: 30

QrCode :: struct {
    version: s32
    size: s32
    ecc: QrEcc
    mask: s32
    // Row-major, one byte a module: 1 is dark.
    modules: [QR_SIZE_MAX * QR_SIZE_MAX]u8
    function: [QR_SIZE_MAX * QR_SIZE_MAX]u8
    data: [QR_CODEWORDS_MAX]u8
    codewords: [QR_CODEWORDS_MAX]u8
    blocks: [QR_CODEWORDS_MAX + QR_BLOCK_MAX]u8
    divisor: [QR_ECC_MAX]u8
    remainder: [QR_ECC_MAX]u8
    bits: s32
}

// Indexed by error correction level * 41 + version; version 0 is unused.
qr_ecc_codewords_per_block: [164]s32 = .[
    -1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
    -1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
    -1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
    -1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30];

qr_error_correction_blocks: [164]s32 = .[
    -1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25,
    -1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49,
    -1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68,
    -1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81];

QR_PENALTY_N1 :: 3
QR_PENALTY_N2 :: 3
QR_PENALTY_N3 :: 40
QR_PENALTY_N4 :: 10

QrEccCodewords :: (ecc: QrEcc, version: s32) -> s32 {
    return qr_ecc_codewords_per_block[cast(s32)ecc * 41 + version]
}

QrEccBlocks :: (ecc: QrEcc, version: s32) -> s32 {
    return qr_error_correction_blocks[cast(s32)ecc * 41 + version]
}

// Data bits a version holds once function modules are excluded, including
// remainder bits.
QrRawDataModules :: (version: s32) -> s32 {
    result := (16 * version + 128) * version + 64
    if version >= 2 {
        count := version / 7 + 2
        result -= (25 * count - 10) * count - 55
        if version >= 7 {
            result -= 36
        }
    }
    return result
}

#program_export
QrDataCodewords :: (version: s32, ecc: QrEcc) -> s32 {
    return QrRawDataModules(version) / 8 - QrEccCodewords(ecc, version) * QrEccBlocks(ecc, version)
}

QrFormatLevel :: (ecc: QrEcc) -> s32 {
    if ecc == cast(QrEcc)QrEccLow { return 1 }
    if ecc == cast(QrEcc)QrEccMedium { return 0 }
    if ecc == cast(QrEcc)QrEccQuartile { return 3 }
    return 2
}

QrBit :: (value: s32, index: s32) -> bool {
    return ((value >> index) & 1) != 0
}

#program_export
QrModule :: (qr: *QrCode, x: s32, y: s32) -> bool {
    return x >= 0 && y >= 0 && x < qr.size && y < qr.size && qr.modules[y * qr.size + x] != cast(u8)0
}

QrSetFunction :: (qr: *QrCode, x: s32, y: s32, dark: bool) {
    qr.modules[y * qr.size + x] = ifx dark then cast(u8)1 else cast(u8)0
    qr.function[y * qr.size + x] = cast(u8)1
}

QrAppendBits :: (qr: *QrCode, value: s32, count: s32) {
    index := count - 1
    while index >= 0 {
        if QrBit(value, index) {
            at := qr.bits >> 3
            qr.data[at] = qr.data[at] | cast(u8)(128 >> (qr.bits & 7))
        }
        qr.bits += 1
        index -= 1
    }
}

QrMultiply :: (x: s32, y: s32) -> s32 {
    z: s32 = 0
    index: s32 = 7
    while index >= 0 {
        z = (z << 1) ^ ((z >> 7) * 285)
        z = z ^ (((y >> index) & 1) * x)
        index -= 1
    }
    return z
}

QrComputeDivisor :: (qr: *QrCode, degree: s32) {
    for index: 0..degree - 1 { qr.divisor[index] = cast(u8)0 }
    qr.divisor[degree - 1] = cast(u8)1
    root: s32 = 1
    for step: 0..degree - 1 {
        for index: 0..degree - 1 {
            qr.divisor[index] = cast(u8)QrMultiply(cast(s32)qr.divisor[index], root)
            if index + 1 < degree {
                qr.divisor[index] = qr.divisor[index] ^ qr.divisor[index + 1]
            }
        }
        root = QrMultiply(root, 2)
    }
}

// The Reed-Solomon remainder of qr.blocks[start:start + count].
QrComputeRemainder :: (qr: *QrCode, start: s32, count: s32, degree: s32) {
    for index: 0..degree - 1 { qr.remainder[index] = cast(u8)0 }
    for offset: 0..count - 1 {
        factor := cast(s32)(qr.blocks[start + offset] ^ qr.remainder[0])
        for index: 0..degree - 2 { qr.remainder[index] = qr.remainder[index + 1] }
        qr.remainder[degree - 1] = cast(u8)0
        for index: 0..degree - 1 {
            qr.remainder[index] = qr.remainder[index] ^ cast(u8)QrMultiply(cast(s32)qr.divisor[index], factor)
        }
    }
}

// Splits the data into blocks, appends each block's error correction and
// interleaves the blocks into qr.codewords.
QrAddEccAndInterleave :: (qr: *QrCode) {
    blocks := QrEccBlocks(qr.ecc, qr.version)
    ecc_length := QrEccCodewords(qr.ecc, qr.version)
    raw := QrRawDataModules(qr.version) / 8
    short_blocks := blocks - raw % blocks
    short_length := raw / blocks
    // Each block occupies short_length + 1 bytes of qr.blocks.
    QrComputeDivisor(qr, ecc_length)
    data_at: s32 = 0
    for block: 0..blocks - 1 {
        data_length := short_length - ecc_length + (ifx block < short_blocks then 0 else 1)
        start := block * (short_length + 1)
        for index: 0..short_length {
            qr.blocks[start + index] = cast(u8)0
        }
        for index: 0..data_length - 1 {
            qr.blocks[start + index] = qr.data[data_at + index]
        }
        data_at += data_length
        QrComputeRemainder(qr, start, data_length, ecc_length)
        for index: 0..ecc_length - 1 {
            qr.blocks[start + short_length + 1 - ecc_length + index] = qr.remainder[index]
        }
    }
    at: s32 = 0
    for index: 0..short_length {
        for block: 0..blocks - 1 {
            // Short blocks have no byte at the padding position.
            if index != short_length - ecc_length || block >= short_blocks {
                qr.codewords[at] = qr.blocks[block * (short_length + 1) + index]
                at += 1
            }
        }
    }
}

QrDrawFormatBits :: (qr: *QrCode, mask: s32) {
    data := QrFormatLevel(qr.ecc) << 3 | mask
    remainder := data
    for step: cast(s32)0..cast(s32)9 {
        remainder = (remainder << 1) ^ ((remainder >> 9) * 1335)
    }
    bits := (data << 10 | remainder) ^ 21522
    for index: cast(s32)0..cast(s32)5 { QrSetFunction(qr, 8, index, QrBit(bits, index)) }
    QrSetFunction(qr, 8, 7, QrBit(bits, 6))
    QrSetFunction(qr, 8, 8, QrBit(bits, 7))
    QrSetFunction(qr, 7, 8, QrBit(bits, 8))
    for index: cast(s32)9..cast(s32)14 { QrSetFunction(qr, 14 - index, 8, QrBit(bits, index)) }
    for index: cast(s32)0..cast(s32)7 { QrSetFunction(qr, qr.size - 1 - index, 8, QrBit(bits, index)) }
    for index: cast(s32)8..cast(s32)14 { QrSetFunction(qr, 8, qr.size - 15 + index, QrBit(bits, index)) }
    QrSetFunction(qr, 8, qr.size - 8, true)
}

QrDrawVersion :: (qr: *QrCode) {
    if qr.version < 7 { return }
    remainder := qr.version
    for step: cast(s32)0..cast(s32)11 {
        remainder = (remainder << 1) ^ ((remainder >> 11) * 7973)
    }
    bits := qr.version << 12 | remainder
    for index: cast(s32)0..cast(s32)17 {
        dark := QrBit(bits, index)
        a := qr.size - 11 + index % 3
        b := index / 3
        QrSetFunction(qr, a, b, dark)
        QrSetFunction(qr, b, a, dark)
    }
}

QrDrawFinder :: (qr: *QrCode, x: s32, y: s32) {
    for dy: cast(s32)-4..cast(s32)4 {
        for dx: cast(s32)-4..cast(s32)4 {
            distance := ifx dx < 0 then -dx else dx
            vertical := ifx dy < 0 then -dy else dy
            if vertical > distance { distance = vertical }
            column := x + dx
            row := y + dy
            if column >= 0 && column < qr.size && row >= 0 && row < qr.size {
                QrSetFunction(qr, column, row, distance != 2 && distance != 4)
            }
        }
    }
}

QrDrawAlignment :: (qr: *QrCode, x: s32, y: s32) {
    for dy: cast(s32)-2..cast(s32)2 {
        for dx: cast(s32)-2..cast(s32)2 {
            distance := ifx dx < 0 then -dx else dx
            vertical := ifx dy < 0 then -dy else dy
            if vertical > distance { distance = vertical }
            QrSetFunction(qr, x + dx, y + dy, distance != 1)
        }
    }
}

QrDrawFunctionPatterns :: (qr: *QrCode) {
    for index: 0..qr.size - 1 {
        QrSetFunction(qr, 6, index, index % 2 == 0)
        QrSetFunction(qr, index, 6, index % 2 == 0)
    }
    QrDrawFinder(qr, 3, 3)
    QrDrawFinder(qr, qr.size - 4, 3)
    QrDrawFinder(qr, 3, qr.size - 4)
    if qr.version > 1 {
        count := qr.version / 7 + 2
        step := (qr.version * 4 + count * 2 + 1) / (count * 2 - 2) * 2
        if qr.version == 32 { step = 26 }
        positions: [7]s32
        positions[0] = 6
        position := qr.size - 7
        index := count - 1
        while index >= 1 {
            positions[index] = position
            position -= step
            index -= 1
        }
        for i: 0..count - 1 {
            for j: 0..count - 1 {
                corner := (i == 0 && j == 0) || (i == 0 && j == count - 1) || (i == count - 1 && j == 0)
                if !corner {
                    QrDrawAlignment(qr, positions[i], positions[j])
                }
            }
        }
    }
    QrDrawFormatBits(qr, 0)
    QrDrawVersion(qr)
}

QrDrawCodewords :: (qr: *QrCode) {
    total := QrRawDataModules(qr.version) / 8 * 8
    bit: s32 = 0
    right := qr.size - 1
    while right >= 1 {
        if right == 6 { right = 5 }
        for vertical: 0..qr.size - 1 {
            for j: cast(s32)0..cast(s32)1 {
                x := right - j
                upward := ((right + 1) & 2) == 0
                y := ifx upward then qr.size - 1 - vertical else vertical
                if qr.function[y * qr.size + x] == cast(u8)0 && bit < total {
                    value := cast(s32)qr.codewords[bit >> 3]
                    qr.modules[y * qr.size + x] = ifx QrBit(value, 7 - (bit & 7)) then cast(u8)1 else cast(u8)0
                    bit += 1
                }
            }
        }
        right -= 2
    }
}

QrApplyMask :: (qr: *QrCode, mask: s32) {
    for y: 0..qr.size - 1 {
        for x: 0..qr.size - 1 {
            invert := false
            if mask == 0 { invert = (x + y) % 2 == 0 }
            else if mask == 1 { invert = y % 2 == 0 }
            else if mask == 2 { invert = x % 3 == 0 }
            else if mask == 3 { invert = (x + y) % 3 == 0 }
            else if mask == 4 { invert = (x / 3 + y / 2) % 2 == 0 }
            else if mask == 5 { invert = x * y % 2 + x * y % 3 == 0 }
            else if mask == 6 { invert = (x * y % 2 + x * y % 3) % 2 == 0 }
            else { invert = ((x + y) % 2 + x * y % 3) % 2 == 0 }
            at := y * qr.size + x
            if invert && qr.function[at] == cast(u8)0 {
                qr.modules[at] = qr.modules[at] ^ cast(u8)1
            }
        }
    }
}

QrPenaltyAddHistory :: (qr: *QrCode, length: s32, history: []s32) {
    if history[0] == 0 { length += qr.size }
    index: s32 = 6
    while index >= 1 {
        history[index] = history[index - 1]
        index -= 1
    }
    history[0] = length
}

QrPenaltyCountPatterns :: (history: []s32) -> s32 {
    n := history[1]
    core := n > 0 && history[2] == n && history[3] == n * 3 && history[4] == n && history[5] == n
    count: s32 = 0
    if core && history[0] >= n * 4 && history[6] >= n { count += 1 }
    if core && history[6] >= n * 4 && history[0] >= n { count += 1 }
    return count
}

QrPenaltyTerminate :: (qr: *QrCode, dark: bool, length: s32, history: []s32) -> s32 {
    if dark {
        QrPenaltyAddHistory(qr, length, history)
        length = 0
    }
    length += qr.size
    QrPenaltyAddHistory(qr, length, history)
    return QrPenaltyCountPatterns(history)
}

QrPenaltyScore :: (qr: *QrCode) -> s32 {
    result: s32 = 0
    for pass: cast(s32)0..cast(s32)1 {
        for line: 0..qr.size - 1 {
            dark := false
            run: s32 = 0
            history: [7]s32
            for index: 0..qr.size - 1 {
                at := ifx pass == 0 then line * qr.size + index else index * qr.size + line
                module := qr.modules[at] != cast(u8)0
                if module == dark {
                    run += 1
                    if run == 5 { result += QR_PENALTY_N1 }
                    else if run > 5 { result += 1 }
                } else {
                    QrPenaltyAddHistory(qr, run, history[:])
                    if !dark { result += QrPenaltyCountPatterns(history[:]) * QR_PENALTY_N3 }
                    dark = module
                    run = 1
                }
            }
            result += QrPenaltyTerminate(qr, dark, run, history[:]) * QR_PENALTY_N3
        }
    }
    for y: 0..qr.size - 2 {
        for x: 0..qr.size - 2 {
            color := qr.modules[y * qr.size + x]
            if color == qr.modules[y * qr.size + x + 1] && color == qr.modules[(y + 1) * qr.size + x] &&
            color == qr.modules[(y + 1) * qr.size + x + 1] {
                result += QR_PENALTY_N2
            }
        }
    }
    dark: s32 = 0
    total := qr.size * qr.size
    for index: 0..total - 1 {
        if qr.modules[index] != cast(u8)0 { dark += 1 }
    }
    balance := dark * 20 - total * 10
    if balance < 0 { balance = -balance }
    k := (balance + total - 1) / total - 1
    result += k * QR_PENALTY_N4
    return result
}

// Encodes text in byte mode at the smallest version that holds it, raising
// the error correction level while the version stays the same. Returns false
// when the text does not fit in version 40 at the requested level.
#program_export
QrEncodeText :: (text: string, ecc: QrEcc, qr: *QrCode) -> bool {
    qr.size = 0
    length := cast(s32)text.count
    version: s32 = QR_VERSION_MIN
    used: s32 = 0
    while true {
        count_bits: s32 = ifx version <= 9 then 8 else 16
        used = 4 + count_bits + length * 8
        if length < (1 << count_bits) && used <= QrDataCodewords(version, ecc) * 8 {
            break
        }
        if version >= QR_VERSION_MAX {
            return false
        }
        version += 1
    }
    level := cast(s32)ecc
    while level < 3 && used <= QrDataCodewords(version, cast(QrEcc)(level + 1)) * 8 {
        level += 1
    }
    qr.version = version
    qr.ecc = cast(QrEcc)level
    qr.size = version * 4 + 17
    capacity := QrDataCodewords(version, qr.ecc) * 8
    for index: 0..capacity / 8 - 1 { qr.data[index] = cast(u8)0 }
    qr.bits = 0
    QrAppendBits(qr, 4, 4)
    QrAppendBits(qr, length, ifx version <= 9 then 8 else 16)
    for byte: text { QrAppendBits(qr, cast(s32)byte, 8) }
    terminator := capacity - qr.bits
    if terminator > 4 { terminator = 4 }
    QrAppendBits(qr, 0, terminator)
    QrAppendBits(qr, 0, (8 - qr.bits % 8) % 8)
    pad: s32 = 236
    while qr.bits < capacity {
        QrAppendBits(qr, pad, 8)
        pad = pad ^ 236 ^ 17
    }
    for index: 0..qr.size * qr.size - 1 {
        qr.modules[index] = cast(u8)0
        qr.function[index] = cast(u8)0
    }
    QrDrawFunctionPatterns(qr)
    QrAddEccAndInterleave(qr)
    QrDrawCodewords(qr)
    best: s32 = 0
    lowest: s32 = -1
    for mask: cast(s32)0..cast(s32)7 {
        QrApplyMask(qr, mask)
        QrDrawFormatBits(qr, mask)
        penalty := QrPenaltyScore(qr)
        if lowest < 0 || penalty < lowest {
            best = mask
            lowest = penalty
        }
        QrApplyMask(qr, mask)
    }
    qr.mask = best
    QrApplyMask(qr, best)
    QrDrawFormatBits(qr, best)
    return true
}
